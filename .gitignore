# Environment-specific configuration (credentials live here)
/config/config.local.php

# Uploaded media — keep the directories, not their contents.
#
# Exception: uploads/products holds the catalogue photography generated by
# bin/import-products.php. Those images ARE the shop — without them a fresh
# deployment shows 60 products with no pictures — and the target host has no
# CLI to regenerate them, so they are version controlled deliberately.
#
# Everything else stays out. uploads/repairs in particular holds customer
# photographs of damaged tack and must never be committed.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/*/
/public/uploads/*/*
!/public/uploads/*/.gitkeep
!/public/uploads/products/*.jpg
!/public/uploads/products/*.webp

# This one is security, not media: it stops anything in the uploads directory
# being executed as PHP. It must ship with the code, not be left to the server.
!/public/uploads/.htaccess

# Logs
/storage/logs/*
!/storage/logs/.gitkeep

# Editor / OS noise
.vscode/
.idea/
*.sublime-*
Thumbs.db
Desktop.ini
.DS_Store

# Database dumps
*.sql.gz
/database/backups/

# Build-time assets fetched on demand, not vendored. bin/make-og-image.php
# renders the share card with the site's own typefaces (Fraunces and Inter);
# the finished card is committed, so the fonts only matter if it is redrawn.
/build/

# Catalogue snapshots written before a replace. Local safety copies of
# whatever that site held; they belong on the server, not in the repo.
/storage/backups/*
!/storage/backups/.gitkeep

# Written by the auto-migrator to remember which migrations it has applied.
# Per-deployment state, never shared: if this were committed, a stale
# fingerprint would stop a server applying what it actually needs.
/storage/.migrations-state
