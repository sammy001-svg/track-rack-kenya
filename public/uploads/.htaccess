# =====================================================================
#  Uploaded files are data, never code.
#  This directory holds visitor- and staff-supplied images only.
# =====================================================================

# Nothing here is ever rewritten to the front controller.
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Refuse to serve anything that could be executed, whatever the handler.
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phps|phar|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Strip any handler that might otherwise execute a file here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'; sandbox"
</IfModule>

Options -Indexes -ExecCGI
